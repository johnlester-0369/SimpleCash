# Copy this file to .env and adjust for your local environment.
# VITE_ prefix is required for Vite to expose a variable to client code
# (see https://vite.dev/guide/env-and-mode) — unprefixed vars stay
# config-only and never reach the browser bundle.

# 'true' enables demo mode: every feature's api.ts routes CRUD through
# localStorage (see src/app/features/*/*.demo.ts) instead of the Express
# API, and admin-auth-client.lib.ts swaps in the fixed-credential demo
# auth client (see src/infra/modules/auth/demo/demo-auth.lib.ts).
# Purely client-side — no server or database is touched either way.
VITE_DEMO_MODE=false