{
  "name": "simplecash-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node dist/server.js",
    "audit": "npm audit --audit-level=high",
