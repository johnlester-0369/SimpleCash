# Copy this file to .env and fill in values for your local environment.
# NODE_ENV and PORT are required — see env.config.ts getRequiredEnv()/getNodeEnv()

# One of: development | production | test
NODE_ENV=development

# Port the HTTP server listens on (see server.ts)
PORT=3000

# One of: error | warn | info | http | verbose | debug | silly (default: info)
LOG_LEVEL=info

# Optional file transports — only used when NODE_ENV=production
# (see createFileTransports in logger.lib.ts)
LOG_FILE_PATH=
ERROR_LOG_FILE_PATH=

# Comma-separated list of allowed CORS origins (see app.ts). Leave unset to
# allow all origins ('*') — only safe for local development.
CORS_ORIGIN=

# Global IP-based rate limit window (ms) and max requests per window (see app.ts)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Stricter rate limit for admin mutating endpoints (POST/PATCH/DELETE),
# layered on top of the global limit above — narrower window and lower
# ceiling per OWASP guidance for sensitive endpoints (see
# strict-rate-limit.middleware.ts)
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX=10

# Max request body size accepted by express.json/urlencoded (see app.ts)
BODY_LIMIT=10kb

# Max time (ms) a request may take before request-timeout.middleware.ts
# aborts it with 503 (see app.ts) — independent of the Node-level
# server.headersTimeout/requestTimeout set in server.ts
REQUEST_TIMEOUT_MS=30000

# Delay (ms) between SIGTERM/SIGINT and actually closing the HTTP server —
# gives the load balancer time to observe the failing /health/ready probe
# and stop routing new traffic before in-flight connections drain (see server.ts)
SHUTDOWN_DRAIN_MS=10000

# Postgres connection string used by Drizzle (see infra/lib/database/db.ts).
# Use Neon's POOLED connection string (hostname ends in "-pooler") since this
# is a long-running Express process — pg's own Pool then multiplexes through
# Neon's PgBouncer instead of opening a raw TCP connection per request.
# sslmode=verify-full is explicit (not the "require" alias) to avoid the
# pg-connection-string deprecation warning while keeping certificate
# verification; db.ts additionally sets ssl: { rejectUnauthorized: true }
# in code, so drizzle-kit's CLI connection and the app's runtime Pool both
# enforce the same guarantee. channel_binding=require ties SCRAM auth to
# the TLS session, closing a narrow relay-MITM window.
# Example: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# Better Auth instance secret/base URL (see infra/modules/auth/auth.ts)
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000